fineweb10B/
pylog124M/
__pycache__/
logs/
.DS_Store

# --- Corpus: large, regenerable from manifest.jsonl. Never commit. ---
# At 3k books this is ~2.4 GB of text and ~1.2 GB of binary shards; at the full
# English Gutenberg catalogue ~72 GB. Committing it bloats history permanently.
data/gutenberg/
data/shards*/*.bin
# Per-slice shards for the mixing dataloader live one level deeper. The rule
# above uses a single `*`, which does NOT cross a directory separator, so these
# 882 MB were untracked-but-not-ignored -- one `git add -A` from entering history.
data/shards*/by_slice/
data/shards_pre_dedup_fix_*/
data/manifest.pre_dedup_fix_*.jsonl
*.bin.tmp
*.jsonl.tmp

# Checkpoints and run artifacts (PLAN.md §4.0.1 keeps the *index*, not the weights).
# `runs/` alone would also exclude the index, because git does not descend into an
# ignored directory to un-ignore a child. Exclude the contents, then re-admit it.
runs/*
!runs/index.jsonl
*.pt
*.safetensors

# Trained tokenizer artifacts (regenerable; the recipe is what matters)
data/tokenizer/

# Generated by smoke_test.py — a build artifact, not source
train_baseline_smoke.py

# Generated by data/prepare_colab_smoke.py; contains hardlinked/copied shards.
/colab_smoke_bundle/
/colab_smoke_bundle.zip

# --- Deliberately NOT ignored, these are the provenance artifacts ---
# data/manifest.jsonl        per-document source/license/hash/split (§6)
# data/val_books.json        pinned validation holdout (§5.5.3)
# data/shards/manifest.json  data recipe: tokenizer, vocab, filter thresholds

# Modal artifacts fetched locally
modal_out*/
